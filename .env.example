# DevForge 18 — environment configuration.
# Copy to `.env` for local overrides. Never commit real secrets.
# The server reads these from the process environment; with Node 22 you can run
#   node --env-file=.env server/src/main.ts
# or export them in your shell / Docker Compose.

# "development" | "production" | "test". Production enables Secure cookies and stricter checks.
NODE_ENV=development

# Interface and port the API + web server listen on.
HOST=127.0.0.1
PORT=8080

# Public origin the browser uses to reach the app (scheme + host + port, no trailing slash).
# Used to validate the Origin header on state-changing requests.
PUBLIC_ORIGIN=http://localhost:8080

# Path of the SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/devforge.db

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Force the Secure flag on cookies (defaults to true when NODE_ENV=production).
# Set to true whenever the site is served over HTTPS.
COOKIE_SECURE=false

# scrypt cost parameter as a power of two (N = 2^PASSWORD_HASH_LOG_N).
# Default 17 follows OWASP guidance. Tests use a lower value for speed; minimum allowed is 14.
PASSWORD_HASH_LOG_N=17

# Set to "true" only when running behind a trusted reverse proxy (e.g. the bundled Nginx)
# so the client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# Log level: "debug" | "info" | "warn" | "error".
LOG_LEVEL=info

# Optional content editor that opens pull requests (docs/adr/0011-cms-pull-requests.md).
# Leave unset to keep it turned off; the server starts either way.
# GITHUB_TOKEN: fine-grained token for this one repository with only
# Contents: read and write and Pull requests: read and write. Never commit it.
# GITHUB_REPOSITORY=your-org/devforge18
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# OpenTelemetry tracing (off unless set; ADR 0009). One span per request, sent as OTLP/HTTP JSON
# to <endpoint>/v1/traces. Spans never contain bodies, headers, query strings or e-mail addresses.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=devforge

# API rate limits per minute (docs/deployment.md, "Rate limits"). Per address: size it as
# (students behind one public address) x 100. Per signed-in user: the main abuse guard.
# API_RATE_LIMIT_PER_IP_PER_MINUTE=6000
# API_RATE_LIMIT_PER_USER_PER_MINUTE=600

# Shared rate limits for several instances (ADR 0010). Unset: counters in each process.
# If Redis is unreachable, each instance falls back to its own counters.
# REDIS_URL=redis://localhost:6379/0
