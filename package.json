{
  "name": "devforge18",
  "version": "0.1.0",
  "private": true,
  "description": "DevForge 18 — an interactive developer engineering academy covering 18 industry technology tracks.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "content:build": "node --disable-warning=ExperimentalWarning scripts/build-content.ts",
    "content:check-links": "node --disable-warning=ExperimentalWarning scripts/check-links.ts",
    "content:audit": "node --disable-warning=ExperimentalWarning scripts/content-audit.ts",
    "measure:page-weight": "node --disable-warning=ExperimentalWarning scripts/measure-page-weight.ts",
    "web:build": "node scripts/build-web.ts",
    "build": "npm run content:build && npm run web:build",
    "start": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "dev": "npm run build && node --disable-warning=ExperimentalWarning --watch-path=server/src server/src/main.ts",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db-migrate.ts",
    "user:create": "node --disable-warning=ExperimentalWarning scripts/create-user.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/**/*.test.ts\" \"shared/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning --test \"e2e/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run typecheck:web && npm run lint:md && npm run build && npm test && npm run test:e2e",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/db-backup.ts",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lessons:record": "node --disable-warning=ExperimentalWarning scripts/record-lessons.ts",
    "lessons:stress": "bash scripts/stress-lesson.sh",
    "ci:record": "bash scripts/ci-record.sh",
    "new:lesson": "node --disable-warning=ExperimentalWarning scripts/new-content.ts lesson",
    "new:lab": "node --disable-warning=ExperimentalWarning scripts/new-content.ts lab",
    "new:quiz": "node --disable-warning=ExperimentalWarning scripts/new-content.ts quiz",
    "new:project": "node --disable-warning=ExperimentalWarning scripts/new-content.ts project",
    "test:e2e:throttled": "DEVFORGE_E2E_CPU_THROTTLE=8 npm run test:e2e",
    "test:compose": "bash scripts/compose-smoke.sh",
    "test:load": "bash scripts/load-test.sh",
    "test:upgrade": "bash scripts/upgrade-test.sh"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "markdownlint-cli2": "0.24.2",
    "marked": "18.0.10",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "overrides": {
    "katex": "^0.18.2",
    "axe-core": "4.14.0"
  }
}
