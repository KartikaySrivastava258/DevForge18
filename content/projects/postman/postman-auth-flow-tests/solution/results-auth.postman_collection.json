{
  "info": {
    "name": "Results API authentication tests",
    "description": "Tests the API key, the OAuth 2.0 client credentials flow and bearer-token checks of the results API. Secrets come only from the environment (apiKey, clientId, clientSecret); tokens are fetched during the run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "API key",
      "item": [
        {
          "name": "Status with the API key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/status",
            "auth": { "type": "apikey", "apikey": [
              { "key": "key", "value": "X-API-Key" },
              { "key": "value", "value": "{{apiKey}}" },
              { "key": "in", "value": "header" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('says ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ] } }]
        },
        {
          "name": "Status without a key",
          "request": { "method": "GET", "url": "{{baseUrl}}/status" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 401', () => pm.response.to.have.status(401));",
            "pm.test('error is invalid_api_key', () => pm.expect(pm.response.json().error).to.eql('invalid_api_key'));"
          ] } }]
        },
        {
          "name": "Status with a wrong key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/status",
            "auth": { "type": "apikey", "apikey": [
              { "key": "key", "value": "X-API-Key" },
              { "key": "value", "value": "wrong-{{apiKey}}" },
              { "key": "in", "value": "header" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 401', () => pm.response.to.have.status(401));",
            "pm.test('error is invalid_api_key', () => pm.expect(pm.response.json().error).to.eql('invalid_api_key'));"
          ] } }]
        }
      ]
    },
    {
      "name": "Client credentials flow",
      "item": [
        {
          "name": "Token with a wrong client secret",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "{{clientId}}" },
              { "key": "password", "value": "not-{{clientSecret}}" }
            ] },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "scope", "value": "grades:read" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 401', () => pm.response.to.have.status(401));",
            "pm.test('error is invalid_client', () => pm.expect(pm.response.json().error).to.eql('invalid_client'));",
            "pm.test('no token is issued', () => pm.expect(pm.response.json()).to.not.have.property('access_token'));"
          ] } }]
        },
        {
          "name": "Token for grades:read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "{{clientId}}" },
              { "key": "password", "value": "{{clientSecret}}" }
            ] },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "scope", "value": "grades:read" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('is a bearer token for grades:read that expires', () => {",
            "  pm.expect(body.token_type).to.eql('Bearer');",
            "  pm.expect(body.scope).to.eql('grades:read');",
            "  pm.expect(body.expires_in).to.be.a('number').above(0);",
            "  pm.expect(body.access_token.split('.')).to.have.lengthOf(3);",
            "});",
            "// Keep the token for the requests below; it is never written to a file.",
            "pm.collectionVariables.set('gradesToken', body.access_token);"
          ] } }]
        },
        {
          "name": "Token for timetable:read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "{{clientId}}" },
              { "key": "password", "value": "{{clientSecret}}" }
            ] },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "scope", "value": "timetable:read" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('has the scope that was asked for', () => pm.expect(pm.response.json().scope).to.eql('timetable:read'));",
            "pm.collectionVariables.set('timetableToken', pm.response.json().access_token);"
          ] } }]
        }
      ]
    },
    {
      "name": "Bearer tokens",
      "item": [
        {
          "name": "Grades with the grades:read token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/grades",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{gradesToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('answers for this client', () => pm.expect(body.client).to.eql(pm.environment.get('clientId')));",
            "pm.test('lists grades', () => pm.expect(body.grades).to.be.an('array').that.is.not.empty);"
          ] } }]
        },
        {
          "name": "Grades without a token",
          "request": { "method": "GET", "url": "{{baseUrl}}/grades" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 401 (authenticate first)', () => pm.response.to.have.status(401));",
            "pm.test('error is invalid_token', () => pm.expect(pm.response.json().error).to.eql('invalid_token'));",
            "pm.test('WWW-Authenticate asks for a bearer token', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer /));"
          ] } }]
        },
        {
          "name": "Grades with a forged token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/grades",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{forgedToken}}" }] }
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "// A forged token: the header and payload of the grades:read token with the signature of the other token.",
              "// The payload is genuine, so only a signature check can reject it.",
              "const [header, payload] = pm.collectionVariables.get('gradesToken').split('.');",
              "const otherSignature = pm.collectionVariables.get('timetableToken').split('.')[2];",
              "pm.collectionVariables.set('forgedToken', `${header}.${payload}.${otherSignature}`);"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('error is invalid_token', () => pm.expect(pm.response.json().error).to.eql('invalid_token'));"
            ] } }
          ]
        },
        {
          "name": "Grades with a token for another scope",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/grades",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{timetableToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 403 (known client, missing permission)', () => pm.response.to.have.status(403));",
            "pm.test('error is insufficient_scope', () => pm.expect(pm.response.json().error).to.eql('insufficient_scope'));",
            "pm.test('WWW-Authenticate names the scope needed', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('scope=\"grades:read\"'));"
          ] } }]
        }
      ]
    }
  ]
}
