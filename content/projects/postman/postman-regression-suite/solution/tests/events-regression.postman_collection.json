{
  "info": {
    "name": "Campus events API — regression",
    "description": "The life of one event: create, read, list, update, read again, delete, read again. The suite creates its own event and deletes it, so it passes on a fresh API and on one it has already run against. Needs baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('says ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }]
    },
    {
      "name": "Create an event",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/events",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\": \"{{eventTitle}}\", \"date\": \"2027-09-15\", \"capacity\": 50, \"venue\": \"Seminar Hall 2\"}" }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "// A title no earlier run has used, so the suite never depends on leftover data.",
          "pm.collectionVariables.set('eventTitle', `Regression check ${Date.now()}`);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('status is 201', () => pm.response.to.have.status(201));",
          "const event = pm.response.json().event;",
          "pm.test('has an id', () => pm.expect(event.id).to.be.a('string').and.not.be.empty);",
          "pm.test('stores the fields that were sent', () => {",
          "  pm.expect(event.title).to.eql(pm.collectionVariables.get('eventTitle'));",
          "  pm.expect(event.date).to.eql('2027-09-15');",
          "  pm.expect(event.capacity).to.eql(50);",
          "  pm.expect(event.venue).to.eql('Seminar Hall 2');",
          "});",
          "pm.collectionVariables.set('eventId', event.id);"
        ] } }
      ]
    },
    {
      "name": "Read the new event",
      "request": { "method": "GET", "url": "{{baseUrl}}/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const event = pm.response.json().event;",
        "pm.test('is the event that was created', () => {",
        "  pm.expect(event.id).to.eql(pm.collectionVariables.get('eventId'));",
        "  pm.expect(event.title).to.eql(pm.collectionVariables.get('eventTitle'));",
        "  pm.expect(event.capacity).to.eql(50);",
        "});"
      ] } }]
    },
    {
      "name": "List includes the new event",
      "request": { "method": "GET", "url": "{{baseUrl}}/events" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const events = pm.response.json().events;",
        "pm.test('is a list of events', () => pm.expect(events).to.be.an('array'));",
        "// The contract does not promise an order, so look the event up by id instead of by position.",
        "pm.test('contains the new event', () => pm.expect(events.map((e) => e.id)).to.include(pm.collectionVariables.get('eventId')));"
      ] } }]
    },
    {
      "name": "Update the capacity",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/events/{{eventId}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"capacity\": 75}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const event = pm.response.json().event;",
        "pm.test('answers with the new capacity', () => pm.expect(event.capacity).to.eql(75));",
        "pm.test('keeps the other fields', () => pm.expect(event.title).to.eql(pm.collectionVariables.get('eventTitle')));"
      ] } }]
    },
    {
      "name": "Read after the update",
      "request": { "method": "GET", "url": "{{baseUrl}}/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('the new capacity was saved', () => pm.expect(pm.response.json().event.capacity).to.eql(75));"
      ] } }]
    },
    {
      "name": "Invalid update",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/events/{{eventId}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"capacity\": -3}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 400', () => pm.response.to.have.status(400));",
        "const err = pm.response.json().error;",
        "pm.test('error code is validation_failed', () => pm.expect(err.code).to.eql('validation_failed'));",
        "pm.test('names the capacity field', () => pm.expect((err.details || []).map((d) => d.field)).to.eql(['capacity']));"
      ] } }]
    },
    {
      "name": "Delete the event",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 204', () => pm.response.to.have.status(204));"
      ] } }]
    },
    {
      "name": "Read after the delete",
      "request": { "method": "GET", "url": "{{baseUrl}}/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 404', () => pm.response.to.have.status(404));",
        "pm.test('error code is not_found', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
      ] } }]
    },
    {
      "name": "Delete it again",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 404', () => pm.response.to.have.status(404));"
      ] } }]
    }
  ]
}
