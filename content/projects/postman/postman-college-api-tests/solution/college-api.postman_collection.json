{
  "info": {
    "name": "College course API tests",
    "description": "Tests the contract of the college course API: the happy paths and every documented error. Run with an environment that sets baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "knownCourse", "value": "CS101" },
    { "key": "unknownCourse", "value": "XX999" },
    { "key": "openCourse", "value": "MA102" },
    { "key": "fullCourse", "value": "CS205" },
    { "key": "studentId", "value": "S1024" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('says ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }]
    },
    {
      "name": "List courses",
      "request": { "method": "GET", "url": "{{baseUrl}}/courses" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('body is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
        "const courses = pm.response.json().courses;",
        "pm.test('lists courses', () => pm.expect(courses).to.be.an('array').that.is.not.empty);",
        "pm.test('every course has a code, title, credits and seats', () => courses.forEach((c) => {",
        "  pm.expect(c.code).to.match(/^[A-Z]{2}[0-9]{3}$/);",
        "  pm.expect(c.title).to.be.a('string').and.not.be.empty;",
        "  pm.expect(c.credits).to.be.a('number').above(0);",
        "  pm.expect(c.seats).to.be.a('number').at.least(0);",
        "}));",
        "// Remember the open course's seats, so the enrolment test can check they go down by one.",
        "const open = courses.find((c) => c.code === pm.collectionVariables.get('openCourse'));",
        "pm.test('the open course is listed', () => pm.expect(open).to.be.an('object'));",
        "if (open) pm.collectionVariables.set('seatsBefore', open.seats);"
      ] } }]
    },
    {
      "name": "Courses in one department",
      "request": { "method": "GET", "url": "{{baseUrl}}/courses?dept=CS" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const courses = pm.response.json().courses;",
        "pm.test('finds CS courses', () => pm.expect(courses).to.be.an('array').that.is.not.empty);",
        "pm.test('lists only CS courses', () => courses.forEach((c) => pm.expect(c.dept).to.eql('CS')));"
      ] } }]
    },
    {
      "name": "One course",
      "request": { "method": "GET", "url": "{{baseUrl}}/courses/{{knownCourse}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const course = pm.response.json().course;",
        "pm.test('is the course that was asked for', () => pm.expect(course.code).to.eql(pm.collectionVariables.get('knownCourse')));",
        "pm.test('has a title and credits', () => {",
        "  pm.expect(course.title).to.be.a('string').and.not.be.empty;",
        "  pm.expect(course.credits).to.be.a('number');",
        "});"
      ] } }]
    },
    {
      "name": "Unknown course",
      "request": { "method": "GET", "url": "{{baseUrl}}/courses/{{unknownCourse}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 404', () => pm.response.to.have.status(404));",
        "pm.test('error code is not_found', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
      ] } }]
    },
    {
      "name": "Enrol a student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses/{{openCourse}}/enrolments",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"studentId\": \"{{studentId}}\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 201', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('enrols the right student in the right course', () => {",
        "  pm.expect(body.enrolment.courseCode).to.eql(pm.collectionVariables.get('openCourse'));",
        "  pm.expect(body.enrolment.studentId).to.eql(pm.collectionVariables.get('studentId'));",
        "});",
        "pm.test('takes one seat', () => pm.expect(body.seatsLeft).to.eql(Number(pm.collectionVariables.get('seatsBefore')) - 1));"
      ] } }]
    },
    {
      "name": "Enrol without a student ID",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses/{{openCourse}}/enrolments",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 400', () => pm.response.to.have.status(400));",
        "const err = pm.response.json().error;",
        "pm.test('error code is validation_failed', () => pm.expect(err.code).to.eql('validation_failed'));",
        "pm.test('names the studentId field', () => pm.expect(err.details.map((d) => d.field)).to.include('studentId'));"
      ] } }]
    },
    {
      "name": "Enrol with a malformed student ID",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses/{{openCourse}}/enrolments",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"studentId\": \"1024\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 400', () => pm.response.to.have.status(400));",
        "pm.test('error code is validation_failed', () => pm.expect(pm.response.json().error.code).to.eql('validation_failed'));"
      ] } }]
    },
    {
      "name": "Enrol in a full course",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses/{{fullCourse}}/enrolments",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"studentId\": \"{{studentId}}\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status is 409', () => pm.response.to.have.status(409));",
        "pm.test('error code is course_full', () => pm.expect(pm.response.json().error.code).to.eql('course_full'));"
      ] } }]
    }
  ]
}
