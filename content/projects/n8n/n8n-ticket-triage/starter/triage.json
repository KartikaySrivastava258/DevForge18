{
  "id": "triage00000001",
  "name": "Support ticket triage",
  "nodes": [
    { "id": "t1", "name": "New ticket", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "8d2f4b6a-1c3e-4a5b-9d7f-0e1a2b3c4d01",
      "parameters": { "httpMethod": "POST", "path": "support-ticket", "responseMode": "responseNode", "options": {} } },
